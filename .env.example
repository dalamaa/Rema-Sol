REMA_SOL_SECRET_KEY=replace-with-a-long-random-flask-session-key
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
REMA_SOL_WALLET_KEY=replace-with-a-fernet-key
REMA_SOL_MERCHANT_USERNAME=replace-with-demo-merchant-username
# Generate with: python -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('replace-me'))"
REMA_SOL_MERCHANT_PASSWORD_HASH=replace-with-a-password-hash
REMA_SOL_DATABASE=/var/lib/remasol/remasol.sqlite3
PORT=5007
REMA_SOL_COOKIE_SECURE=0
REMA_SOL_TRUST_PROXY=0
SOLANA_RPC_URL=https://api.devnet.solana.com
FLASK_DEBUG=0
RATE_LIMIT_ENABLED=1
CHECKOUT_EXPIRY_MINUTES=60
MAX_UNPAID_CHECKOUTS_PER_IP=8
REFUND_FEE_BUFFER_LAMPORTS=10000
# Public demo guardrails. The app generates a dedicated treasury wallet on first boot
# when REMA_SOL_WALLET_KEY is configured; fund it manually with Devnet SOL.
DEMO_PRODUCT_SLUG=the-digital-creator-s-guide
DEMO_MIN_PAYMENT_LAMPORTS=500000
DEMO_MAX_PAYMENT_LAMPORTS=20000000
DEMO_FUNDING_FEE_BUFFER_LAMPORTS=100000
DEMO_DAILY_BUDGET_LAMPORTS=100000000
DEMO_MAX_CONCURRENT_DEMOS=3
